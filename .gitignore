# Local secret files (NEVER PUSH THESE)
*.tfvars
*.tfvars.json
terraform.tfvars
secrets.tf

# Terraform state files (Contains raw secrets and current infrastructure state)
*.tfstate
*.tfstate.backup
.terraform.tfstate.lock.info

# Terraform working directory (Massive local cache folder)
.terraform/

# Personal SSH keys (Just in case you generated keys locally)
*.pem
id_rsa
id_rsa.pub